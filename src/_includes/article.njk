---
layout: base.njk
---
<article class="article">
  <div class="stamp-row">
    <span class="date-mono">{{ date | readableDate }} &middot; {{ content | readingTime }}</span>
    {% for tag in tags %}
    <span class="tag-pill" style="background: {{ tag | tagColor }}; color: {{ tag | tagTextColor }};">{{ tag }}</span>
    {% endfor %}
  </div>
  <h1 class="article-title">{{ title }}<span class="cursor"></span></h1>
  <p class="byline">by {{ author or "Oliver" }}</p>

  <div class="article-body">
    {{ content | safe }}
  </div>

  {% set prevPost = collections.articles | getPreviousCollectionItem %}
  {% set nextPost = collections.articles | getNextCollectionItem %}
  {% if prevPost or nextPost %}
  <nav class="article-nav">
    {% if prevPost %}
    <a class="article-nav-link" href="{{ prevPost.url }}">&larr; {{ prevPost.data.title }}</a>
    {% else %}
    <span></span>
    {% endif %}
    {% if nextPost %}
    <a class="article-nav-link" href="{{ nextPost.url }}">{{ nextPost.data.title }} &rarr;</a>
    {% endif %}
  </nav>
  {% endif %}

  <section class="comments">
    <h2 class="comments-heading">Comments</h2>
    <!--
      GISCUS SETUP (do this once your GitHub repo exists):
      1. Turn on Discussions for your repo: repo Settings → General → Features → Discussions
      2. Go to https://giscus.app, fill in your repo name, and it will generate a
         <script> snippet with your specific data-repo-id and data-category-id values.
      3. Replace the placeholder attributes below with the ones giscus.app gives you.
    -->
    <script src="https://giscus.app/client.js"
      data-repo="ollielopez0203/I-Like-Writing"
      data-repo-id="R_kgDOTmisGQ"
      data-category="Comments"
      data-category-id="DIC_kwDOTmisGc4DCNA_"
      data-mapping="pathname"
      data-reactions-enabled="1"
      data-emit-metadata="0"
      data-input-position="bottom"
      data-theme="light"
      data-lang="en"
      crossorigin="anonymous"
      async>
    </script>
  </section>

  <a class="back-link" href="/">&larr; back to all writing</a>
</article>
